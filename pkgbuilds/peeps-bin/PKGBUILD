# Maintainer: Duff OMelia <https://github.com/duff>
pkgname=peeps-bin
pkgver=1.0.0
pkgrel=1
pkgdesc="Keyboard-first address book for Omarchy that reads and writes Google Contacts (binary release)"
arch=(x86_64)
url="https://github.com/duff/peeps"
license=(MIT)
# The release is built with Peeps' verified Google OAuth client, so people
# only choose Connect. That client is why this ships the upstream binary
# instead of building here. It links only Qt's public API.
depends=(gcc-libs glibc glib2 hicolor-icon-theme libglvnd libsecret 'qt6-base>=6.12')
optdepends=('org.freedesktop.secrets: keep the Google sign-in in the login keyring')
provides=(peeps)
conflicts=(peeps)
options=(!strip !debug)
source_x86_64=("$url/releases/download/v$pkgver/peeps-$pkgver-x86_64-linux.tar.gz")
sha256sums_x86_64=('a1c17e6d39409d426c89d4874dee8657530d915ff0d72ba03ac29841d939ca42')

package() {
  # The release tarball is a ready usr/ tree: the binary, the desktop entry
  # and icon, the agent skill Peeps links for each person, and the licence.
  cp -a "$srcdir/usr" "$pkgdir/"
  mv "$pkgdir/usr/share/licenses/peeps" "$pkgdir/usr/share/licenses/$pkgname"
}
